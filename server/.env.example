NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/h_ecommerce_dev

# CORS / cookies (ADR-002)
CLIENT_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# Auth (ADR: never localStorage for access tokens; see docs/ADR.md §6 in build plan)
JWT_ACCESS_SECRET=replace_me_dev_only
JWT_REFRESH_SECRET=replace_me_dev_only_too
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email (Resend/Mailgun sandbox — Phase 3)
EMAIL_FROM=no-reply@hstore.pk
RESEND_API_KEY=

# Cloudinary (Phase 7 admin uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments (Phase 5 — real gateway TBD: PayFast/Safepay/Simpaisa; mock in the
# meantime, see server/src/services/payments/MockGatewayProvider.ts)
PAYMENT_PROVIDER=cod
MOCK_GATEWAY_SECRET=mock-gateway-dev-secret
PENDING_ORDER_EXPIRY_MINUTES=30

# On-demand ISR (Phase 7) — must match the client's REVALIDATE_SECRET exactly
REVALIDATE_SECRET=revalidate-dev-secret
